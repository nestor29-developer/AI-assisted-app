# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
!/docker/rds-global-bundle.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# eval reports are local output; the interesting numbers go in the docs
/evals/reports/

# env files: real values stay local, the template is tracked
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# terraform: state, local values and plans stay out; the lock file and the .example files are tracked
/infra/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
/infra/terraform/*.tfvars
/infra/terraform/backend.hcl
