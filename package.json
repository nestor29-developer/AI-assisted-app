{
  "name": "ai-document-qa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:pretty": "next dev | pino-pretty",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "setup": "node scripts/setup-env.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env scripts/migrate.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "smoke:gemini": "tsx --conditions=react-server --env-file-if-exists=.env scripts/smoke-gemini.ts",
    "eval": "tsx --conditions=react-server --env-file-if-exists=.env scripts/eval.ts"
  },
  "dependencies": {
    "@google/genai": "^2.26.0",
    "@node-rs/argon2": "^2.2.1",
    "@tanstack/react-query": "^5.104.0",
    "cookie": "^2.0.1",
    "drizzle-orm": "^0.45.3",
    "eventsource-parser": "^4.1.1",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "description": "AI-assisted document Q&A: Next.js + Postgres/pgvector + Gemini (RAG, streaming, structured output)",
  "engines": {
    "node": ">=22.0.0"
  }
}
