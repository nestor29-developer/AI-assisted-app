# Copy to .env (gitignored) and adjust. Every value below is a local-development default.
NODE_ENV=development
LOG_LEVEL=info
# Browser origin(s) allowed to call the API, comma-separated. Must match how you open the app.
APP_ORIGIN=http://localhost:3000

# 32+ chars. Placeholder works locally only; production refuses to boot with it.
# Generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000

# Matches docker-compose.yml. In AWS the PG* variables come from Secrets Manager instead.
DATABASE_URL=postgresql://app:app@localhost:5432/docqa

# mock = deterministic offline provider, no API key needed. gemini = real model.
LLM_PROVIDER=mock
LLM_MODEL=gemini-3.8-flash
# Required only when LLM_PROVIDER=gemini. Never commit a real key.
GEMINI_API_KEY=
# The mock pauses 40 ms per streamed chunk, enough to see the stages and try Stop.
# Raise this (milliseconds per chunk) to linger on them.
# MOCK_LLM_CHUNK_DELAY_MS=300
